# No variables are required for a local demo. Partial live configuration fails closed.
SKYCITY_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase transaction pooler connection string. Keep server-side.
SUPABASE_DB_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=SkyCity <hello@your-domain.com>
CRON_SECRET=
# Comma-separated emails, checked against verified Supabase users.
ADMIN_EMAILS=
# Explicit opt-in for a hosted demo. Never use with real customer data.
ALLOW_HOSTED_DEMO=false
# Initial default; persisted city settings can be changed by an administrator.
TAKEOVER_PROTECTION_HOURS=24
# Holder details shown on the legal pages (set them in Vercel, never in the repo).
LEGAL_OWNER=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Only for companies: commercial registry details.
LEGAL_REGISTRY=
